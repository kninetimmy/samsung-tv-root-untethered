<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>LinuxCutoverHelper</AssemblyName>
    <StartupObject>LinuxCutoverHelper</StartupObject>
    <UseAppHost>false</UseAppHost>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>8.0</LangVersion>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="LinuxCutoverHelper.cs" />
    <Compile Include="../LinuxRebootHelper.cs" Link="LinuxRebootHelper.cs" />
    <EmbeddedResource Include="../snapshot.sh" LogicalName="snapshot.sh" />
  </ItemGroup>
</Project>
